<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Only compile files explicitly listed below. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin itself uses only this source file. -->
    <Compile Include="EntryPoint.cs" />

    <EmbeddedResource Include="AppIcons\pluginIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SyMenu.Plugin.Resources">
      <HintPath>res\SyMenu.Plugin.Resources.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
